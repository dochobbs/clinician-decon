#!/bin/zsh
set -euo pipefail

APP_VERSION="0.1.0"
CONTENTS_DIR="$(cd "$(dirname "$0")/.." && pwd)"
RESOURCE_DIR="$CONTENTS_DIR/Resources"
PACKAGE_DIR="$RESOURCE_DIR/package"
APP_SUPPORT="$HOME/Library/Application Support/Clinician Decon"
VENV_DIR="$APP_SUPPORT/venv"
LOG_DIR="$APP_SUPPORT/logs"
INSTALL_STAMP="$APP_SUPPORT/.installed-version"
SERVER_URL="http://127.0.0.1:8769"
OPEN_BROWSER="${DECON_NO_BROWSER:-0}"
PYTHON_BIN="${DECON_PYTHON:-/usr/bin/python3}"
BUNDLED_PYTHON="$RESOURCE_DIR/python/bin/python"
BUNDLED_SITE_PACKAGES="$RESOURCE_DIR/python-packages"
BUNDLED_MODEL_DIR="$PACKAGE_DIR/local-models/OpenMed--OpenMed-PII-SuperClinical-Large-434M-v1"

mkdir -p "$APP_SUPPORT" "$LOG_DIR"
SETUP_LOG="$LOG_DIR/setup.log"
SERVER_LOG="$LOG_DIR/server.log"
SERVER_PID_FILE="$APP_SUPPORT/server.pid"

alert() {
  /usr/bin/osascript -e "display dialog \"$1\" buttons {\"OK\"} default button \"OK\" with title \"Clinician Decon\"" >/dev/null 2>&1 || true
}

notify() {
  /usr/bin/osascript -e "display notification \"$1\" with title \"Clinician Decon\"" >/dev/null 2>&1 || true
}

open_local_ui() {
  if [[ "$OPEN_BROWSER" != "1" ]]; then
    /usr/bin/open "$SERVER_URL/"
  fi
}

if [[ ! -d "$PACKAGE_DIR" ]]; then
  alert "Clinician Decon is missing its bundled package files. Reinstall from the DMG."
  exit 1
fi

export PYTHONPATH="$PACKAGE_DIR/src${PYTHONPATH:+:$PYTHONPATH}"

start_local_app() {
  local python_bin="$1"
  local notified=0

  if /usr/bin/curl -fsS "$SERVER_URL/api/setup/status" >/dev/null 2>&1; then
    open_local_ui
    exit 0
  fi

  "$python_bin" -m decon.app_server >> "$SERVER_LOG" 2>&1 &
  SERVER_PID=$!
  echo "$SERVER_PID" > "$SERVER_PID_FILE"
  cleanup() {
    /bin/kill "$SERVER_PID" >/dev/null 2>&1 || true
    /bin/rm -f "$SERVER_PID_FILE" >/dev/null 2>&1 || true
  }
  trap cleanup EXIT INT TERM

  for attempt in {1..45}; do
    if /usr/bin/curl -fsS "$SERVER_URL/api/setup/status" >/dev/null 2>&1; then
      open_local_ui
      wait "$SERVER_PID"
      exit $?
    fi
    if [[ "$attempt" -eq 4 && "$notified" == "0" ]]; then
      notify "Starting the local privacy engine. The app window will open automatically."
      notified=1
    fi
    /bin/sleep 1
  done

  /bin/kill "$SERVER_PID" >/dev/null 2>&1 || true
  alert "Clinician Decon did not start. Reopen the app once. If this keeps happening, see $SERVER_LOG."
  exit 1
}

if [[ -x "$BUNDLED_PYTHON" ]]; then
  if [[ ! -d "$BUNDLED_MODEL_DIR" ]]; then
    alert "Clinician Decon is missing its bundled OpenMed model files. Reinstall from the self-contained DMG."
    exit 1
  fi
  if [[ ! -d "$BUNDLED_SITE_PACKAGES" ]]; then
    alert "Clinician Decon is missing its bundled Python packages. Reinstall from the self-contained DMG."
    exit 1
  fi
  export PYTHONPATH="$PACKAGE_DIR/src:$BUNDLED_SITE_PACKAGES${PYTHONPATH:+:$PYTHONPATH}"
  export DECON_HOME="$APP_SUPPORT"
  export DECON_MODEL_DIR="$BUNDLED_MODEL_DIR"
  start_local_app "$BUNDLED_PYTHON"
fi

if ! "$PYTHON_BIN" -c "import venv" >/dev/null 2>&1; then
  alert "Python 3 with venv support is required for this bootstrap build. Install Python 3, then reopen Clinician Decon."
  exit 1
fi

NEEDS_RUNTIME=0
if [[ ! -x "$VENV_DIR/bin/python" ]]; then
  NEEDS_RUNTIME=1
elif [[ ! -f "$INSTALL_STAMP" ]]; then
  NEEDS_RUNTIME=1
elif [[ "$(<"$INSTALL_STAMP")" != "$APP_VERSION" ]]; then
  NEEDS_RUNTIME=1
fi

if [[ "$NEEDS_RUNTIME" == "1" ]]; then
  notify "Preparing local runtime. First launch can take several minutes."
  {
    echo "== $(date -u '+%Y-%m-%dT%H:%M:%SZ') runtime setup =="
    "$PYTHON_BIN" -m venv "$VENV_DIR"
    "$VENV_DIR/bin/python" -m pip install --disable-pip-version-check --upgrade pip setuptools wheel
    "$VENV_DIR/bin/python" -m pip install --disable-pip-version-check "$PACKAGE_DIR[openmed]"
    echo "$APP_VERSION" > "$INSTALL_STAMP"
  } >> "$SETUP_LOG" 2>&1 || {
    alert "Local runtime setup failed. See $SETUP_LOG."
    exit 1
  }
fi

if [[ "${DECON_SKIP_OPENMED_SETUP:-0}" != "1" ]]; then
  if ! DECON_HOME="$APP_SUPPORT" "$VENV_DIR/bin/python" - <<'PY' >/dev/null 2>&1
from decon.model_setup import get_model_status
raise SystemExit(0 if get_model_status().ner_model_ready else 1)
PY
  then
    notify "Downloading local privacy model. This can take several minutes."
    if ! DECON_HOME="$APP_SUPPORT" "$VENV_DIR/bin/decon-setup-openmed" >> "$SETUP_LOG" 2>&1; then
      alert "OpenMed setup did not complete. The app will open, but copy is blocked until model setup succeeds. See $SETUP_LOG."
    fi
  fi
fi

export DECON_HOME="$APP_SUPPORT"
start_local_app "$VENV_DIR/bin/python"
